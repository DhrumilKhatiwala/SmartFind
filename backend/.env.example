# Google Gemini API Key (for LangChain SelfQueryRetriever LLM query parsing)
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Cloud Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ecommerce-products
PINECONE_ENVIRONMENT=us-east-1

# Langfuse LLM Observability (https://cloud.langfuse.com)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# MongoDB Atlas Connection (for user auth & cart)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/smartfind
MONGODB_DB_NAME=smartfind

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
